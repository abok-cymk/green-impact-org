{
  "compilerOptions": {
    "target": "es2020",
    "module": "ESNext",
    "lib": ["es2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "Node",
    "types": ["node"],
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "pesapal/**/*.ts",
    "resend/**/*.ts",
    "resend/subscribe.tsx",
    "resend/contact.ts"
  ]
}
